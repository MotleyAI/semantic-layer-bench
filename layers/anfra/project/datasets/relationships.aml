// Generated by layers/anfra/translate.py: the 11 OSSIE relationships.
Relationship lineitem_to_orders {
  type: 'many_to_one'
  from: r(lineitem.l_orderkey)
  to: r(orders.order_key)
}

Relationship lineitem_to_part {
  type: 'many_to_one'
  from: r(lineitem.l_partkey)
  to: r(part.p_partkey)
}

Relationship lineitem_to_supplier {
  type: 'many_to_one'
  from: r(lineitem.l_suppkey)
  to: r(supplier.supplier_key)
}

Relationship lineitem_to_partsupp {
  type: 'many_to_one'
  from: r(lineitem.l_partkey)
  to: r(partsupp.ps_partkey)
  on { from: r(lineitem.l_suppkey) to: r(partsupp.ps_suppkey) }
}

Relationship orders_to_customer {
  type: 'many_to_one'
  from: r(orders.customer_key)
  to: r(customer.customer_key)
}

Relationship customer_to_customer_nation {
  type: 'many_to_one'
  from: r(customer.c_nationkey)
  to: r(customer_nation.n_nationkey)
}

Relationship customer_nation_to_customer_region {
  type: 'many_to_one'
  from: r(customer_nation.n_regionkey)
  to: r(customer_region.r_regionkey)
}

Relationship supplier_to_supplier_nation {
  type: 'many_to_one'
  from: r(supplier.s_nationkey)
  to: r(supplier_nation.n_nationkey)
}

Relationship supplier_nation_to_supplier_region {
  type: 'many_to_one'
  from: r(supplier_nation.n_regionkey)
  to: r(supplier_region.r_regionkey)
}

Relationship partsupp_to_part {
  type: 'many_to_one'
  from: r(partsupp.ps_partkey)
  to: r(part.p_partkey)
}

Relationship partsupp_to_supplier {
  type: 'many_to_one'
  from: r(partsupp.ps_suppkey)
  to: r(supplier.supplier_key)
}
