// Generated by layers/anfra/translate.py: the shared OSSIE model as one AML dataset.
Dataset tpch {
  label: 'tpch'
  description: 'TPC-H sales: line items, orders, customers, suppliers, parts and supply offers'
  data_source_name: 'tpch'
  models: [lineitem, orders, customer, customer_nation, customer_region, supplier, supplier_nation, supplier_region, part, partsupp]
  relationships: [
    relationship(lineitem_to_orders, true),
    relationship(lineitem_to_part, true),
    relationship(lineitem_to_supplier, true),
    relationship(lineitem_to_partsupp, true),
    relationship(orders_to_customer, true),
    relationship(customer_to_customer_nation, true),
    relationship(customer_nation_to_customer_region, true),
    relationship(supplier_to_supplier_nation, true),
    relationship(supplier_nation_to_supplier_region, true),
    relationship(partsupp_to_part, true),
    relationship(partsupp_to_supplier, true),
  ]

  metric revenue {
    label: 'revenue'
    type: 'number'
    description: 'Net revenue after discount'
    definition: @aql lineitem | sum(lineitem.extended_price * (1 - lineitem.discount));;
  }

  metric gross_sales {
    label: 'gross_sales'
    type: 'number'
    description: 'Revenue before discount'
    definition: @aql lineitem | sum(lineitem.extended_price);;
  }

  metric total_quantity {
    label: 'total_quantity'
    type: 'number'
    description: 'Units sold'
    definition: @aql lineitem | sum(lineitem.quantity);;
  }

  metric line_count {
    label: 'line_count'
    type: 'number'
    description: 'Number of order lines'
    definition: @aql lineitem | count(lineitem.l_orderkey);;
  }

  metric avg_discount {
    label: 'avg_discount'
    type: 'number'
    description: 'Average line discount'
    definition: @aql lineitem | avg(lineitem.discount);;
  }

  metric order_count {
    label: 'order_count'
    type: 'number'
    description: 'Number of orders'
    definition: @aql orders | count(orders.order_key);;
  }

  metric order_value {
    label: 'order_value'
    type: 'number'
    description: 'Sum of order total price'
    definition: @aql orders | sum(orders.total_price);;
  }

  metric avg_order_value {
    label: 'avg_order_value'
    type: 'number'
    description: 'Order value per order'
    definition: @aql (orders | sum(orders.total_price)) / (orders | count(orders.order_key));;
  }

  metric customer_count {
    label: 'customer_count'
    type: 'number'
    description: 'Distinct customers'
    definition: @aql customer | count_distinct(customer.customer_key);;
  }

  metric total_available_qty {
    label: 'total_available_qty'
    type: 'number'
    description: 'Supply quantity available'
    definition: @aql partsupp | sum(partsupp.available_qty);;
  }

  metric supplier_count {
    label: 'supplier_count'
    type: 'number'
    description: 'Distinct suppliers'
    definition: @aql supplier | count_distinct(supplier.supplier_key);;
  }
}
