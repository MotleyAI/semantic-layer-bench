explore {
  dimensions { order_year: orders.order_date | year() }
  measures {
    revenue: revenue,
    revenue_growth: revenue / (revenue | relative_period(orders.order_date, interval(-1 year))) - 1,
  }
  filters { orders.order_date matches @(1993-01-01 - 1997-12-31) }
  sorts { order_year asc }
}
