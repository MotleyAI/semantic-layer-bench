dimension customer.orders_1996 = order_count | where(orders.order_date matches @(1996-01-01 - 1996-12-31)) | dimensionalize(customer.customer_key);
dimension customer.orders_1997 = order_count | where(orders.order_date matches @(1997-01-01 - 1997-12-31)) | dimensionalize(customer.customer_key);
dimension customer.is_lapsed = coalesce(customer.orders_1996, 0) > 0 and coalesce(customer.orders_1997, 0) == 0;
explore {
  dimensions { market_segment: customer.market_segment }
  measures {
    lapsed_customer_count: customer_count,
    lapsed_revenue_1996: coalesce(revenue | where(orders.order_date matches @(1996-01-01 - 1996-12-31)), 0),
  }
  filters { customer.is_lapsed is true }
  sorts { market_segment asc }
}
