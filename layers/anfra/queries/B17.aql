dimension part.min_supply_cost = partsupp | min(partsupp.supply_cost) | dimensionalize(part.part_name, part.manufacturer);
explore {
  dimensions { manufacturer: part.manufacturer }
  measures {
    cheapest_source_qty_share: (total_quantity | where(partsupp.supply_cost == part.min_supply_cost)) / total_quantity,
  }
  filters { lineitem.ship_date matches @(1997-01-01 - 1997-12-31) }
  sorts { manufacturer asc }
}
