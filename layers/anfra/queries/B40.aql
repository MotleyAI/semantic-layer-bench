dimension part.container_size = split_part(part.container, ' ', 1);
explore {
  dimensions { container_size: part.container_size }
  measures {
    revenue: revenue,
    revenue_share: revenue / (revenue | exclude_grains(part.container_size)),
  }
  filters { orders.order_date matches @(1997-01-01 - 1997-12-31) }
  sorts { container_size asc }
}
