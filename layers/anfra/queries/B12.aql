explore {
  dimensions { part_type: part.part_type }
  measures {
    total_available_qty: total_available_qty,
    total_quantity_1997: total_quantity | where(orders.order_date matches @(1997-01-01 - 1997-12-31)),
    cover_ratio: total_available_qty / (total_quantity | where(orders.order_date matches @(1997-01-01 - 1997-12-31))),
  }
  filters { part.part_type like '%BRASS%' }
  sorts { part_type asc }
}
