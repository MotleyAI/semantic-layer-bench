dimension customer.lifetime_orders = order_count | dimensionalize(customer.customer_key);
dimension customer.order_count_bucket = case(
  when: customer.lifetime_orders < 10, then: '1-9',
  when: customer.lifetime_orders < 15, then: '10-14',
  when: customer.lifetime_orders < 20, then: '15-19',
  when: customer.lifetime_orders < 25, then: '20-24',
  else: '25+'
);
explore {
  dimensions { order_count_bucket: customer.order_count_bucket }
  measures { customer_count: customer_count, revenue: revenue }
  filters { customer.lifetime_orders > 0 }
  sorts { order_count_bucket asc }
}
