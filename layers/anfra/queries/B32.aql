dimension lineitem.line_margin = lineitem.extended_price * (1 - lineitem.discount) - partsupp.supply_cost * lineitem.quantity;
explore {
  dimensions { brand: part.brand }
  measures {
    below_cost_line_share: (lineitem | count_if(lineitem.line_margin < 0)) / line_count,
    below_cost_margin: coalesce(lineitem | where(lineitem.line_margin < 0) | sum(lineitem.line_margin), 0),
  }
  filters { orders.order_date matches @(1997-01-01 - 1997-12-31) }
  sorts { brand asc }
}
