metric aov_1996 = avg_order_value | where(orders.order_date matches @(1996-01-01 - 1996-12-31));
metric aov_1997 = avg_order_value | where(orders.order_date matches @(1997-01-01 - 1997-12-31));
metric orders_1996 = order_count | where(orders.order_date matches @(1996-01-01 - 1996-12-31));
metric orders_1997 = order_count | where(orders.order_date matches @(1997-01-01 - 1997-12-31));
explore {
  dimensions { clerk: orders.clerk }
  measures {
    avg_order_value_1996: aov_1996,
    avg_order_value_1997: aov_1997,
    avg_order_value_change: aov_1997 - aov_1996,
  }
  having { orders_1996 > 99, orders_1997 > 99 }
  sorts { avg_order_value_change desc, clerk asc }
  limit: 10
}
