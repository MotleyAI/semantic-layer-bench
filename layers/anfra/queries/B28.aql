explore {
  dimensions { order_year: orders.order_date | year() }
  measures {
    returned_revenue: coalesce(revenue | where(lineitem.return_flag == 'R'), 0),
    returned_revenue_share: coalesce(revenue | where(lineitem.return_flag == 'R'), 0) / revenue,
  }
  filters { orders.order_date matches @(1992-01-01 - 1997-12-31) }
  sorts { order_year asc }
}
