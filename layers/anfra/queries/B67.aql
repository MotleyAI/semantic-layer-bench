dimension orders.is_1997 = orders.order_date matches @(1997-01-01 - 1997-12-31);
metric decile_within_year_flag = ntile(10,
  order: orders | max(orders.total_price) | desc(),
  order: orders | min(orders.order_key) | asc(),
  partition: orders.is_1997
);
dimension orders.value_decile = decile_within_year_flag;
explore {
  dimensions { value_decile: orders.value_decile }
  measures {
    order_count: order_count,
    order_value: order_value,
    order_value_share: order_value / (order_value | exclude_grains(orders.value_decile)),
    min_total_price: orders | min(orders.total_price),
    max_total_price: orders | max(orders.total_price),
  }
  filters { orders.is_1997 is true }
  sorts { value_decile asc }
}
