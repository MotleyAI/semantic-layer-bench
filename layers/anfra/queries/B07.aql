explore {
  dimensions { supplier_name: supplier.supplier_name }
  measures {
    line_count: line_count,
    late_share: (lineitem | count_if(lineitem.receipt_date > lineitem.commit_date)) / line_count,
  }
  filters { lineitem.receipt_date matches @(1996-01-01 - 1997-12-31) }
  having { line_count > 99 }
  sorts { late_share desc, supplier_name asc }
  limit: 10
}
