explore {
  dimensions { customer_region_name: customer_region.customer_region_name }
  measures {
    revenue: revenue,
    customer_count: customer_count,
    revenue_per_customer: revenue / customer_count,
  }
  filters { orders.order_date matches @(1997-01-01 - 1997-12-31) }
  sorts { customer_region_name asc }
}
