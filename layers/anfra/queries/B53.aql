dimension orders.late_lines = lineitem | count_if(lineitem.receipt_date > lineitem.commit_date) | dimensionalize(orders.order_key);
explore {
  dimensions {
    order_year: orders.order_date | year(),
    order_priority: orders.order_priority,
  }
  measures {
    order_count: order_count,
    perfect_order_share: (order_count | where(coalesce(orders.late_lines, 0) == 0)) / order_count,
  }
  filters { orders.order_date matches @(1993-01-01 - 1997-12-31) }
  sorts { order_year asc, order_priority asc }
}
