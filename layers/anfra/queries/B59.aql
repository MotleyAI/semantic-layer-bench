metric revenue_1996 = revenue | where(orders.order_date matches @(1996-01-01 - 1996-12-31));
metric revenue_1997 = revenue | where(orders.order_date matches @(1997-01-01 - 1997-12-31));
metric quantity_1996 = total_quantity | where(orders.order_date matches @(1996-01-01 - 1996-12-31));
metric quantity_1997 = total_quantity | where(orders.order_date matches @(1997-01-01 - 1997-12-31));
explore {
  dimensions { manufacturer: part.manufacturer }
  measures {
    revenue_1996: revenue_1996,
    revenue_1997: revenue_1997,
    revenue_change: revenue_1997 - revenue_1996,
    volume_effect: (quantity_1997 - quantity_1996) * (revenue_1996 / quantity_1996),
    price_effect: (revenue_1997 / quantity_1997 - revenue_1996 / quantity_1996) * quantity_1997,
  }
  sorts { manufacturer asc }
}
