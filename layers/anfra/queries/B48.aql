metric brand_rank = rank(
  order: revenue | desc(),
  order: part | min(part.brand) | asc(),
  partition: customer_region.customer_region_name
);
explore {
  dimensions {
    customer_region_name: customer_region.customer_region_name,
    brand: part.brand,
  }
  measures {
    revenue: revenue,
    brand_rank: brand_rank,
  }
  filters { orders.order_date matches @(1997-01-01 - 1997-12-31) }
  having { brand_rank < 4 }
  sorts { customer_region_name asc, brand_rank asc }
}
