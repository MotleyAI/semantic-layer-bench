metric revenue_h1_1997 = revenue | where(orders.order_date matches @(1997-01-01 - 1997-06-30));
metric revenue_h1_1998 = revenue | where(orders.order_date matches @(1998-01-01 - 1998-06-30));
explore {
  dimensions { customer_region_name: customer_region.customer_region_name }
  measures {
    revenue_h1_1997: revenue_h1_1997,
    revenue_h1_1998: revenue_h1_1998,
    revenue_growth: revenue_h1_1998 / revenue_h1_1997 - 1,
  }
  sorts { customer_region_name asc }
}
