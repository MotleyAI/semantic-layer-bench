      "order_key",
      "order_date"
     ],
     "measures": [
      {
       "formula": "min(order_date, partition_by=customer_key)",
       "name": "first_order"
      }
     ]
    },
    {
     "name": "per_customer",
     "source_model": "per_order",
     "dimensions": [
      "customer_key",
      {
       "expression": "date_part('year', first_order)",
       "name": "first_order_year"
      }
     ],
     "measures": [
      {
       "formula": "max(iif(date_part('year', order_date) == date_part('year', first_order) + 1, 1, 0))",
       "name": "retained"
      }
     ]
    },
    {
     "source_model": "per_customer",
     "dimensions": [
      "first_order_year"
     ],
     "measures": [
      {
       "formula": "count(*)",
       "name": "customer_count"
      },
      {
       "formula": "avg(retained * 1.0)",
       "name": "retained_next_year_share"
      }
     ],
     "filters": [
      "first_order_year >= 1992",
      "first_order_year <= 1996"
     ]
    }
   ],
