  {
   "id": "B17",
   "status": "attempted",
   "interface": "query",
   "query": [
    {
     "name": "min_cost",
     "source_model": "partsupp",
     "dimensions": [
      "part.part_name",
      "part.manufacturer"
     ],
     "measures": [
      {
       "formula": "min(supply_cost)",
       "name": "min_supply_cost"
      }
     ]
    },
    {
     "name": "offer_lines",
     "source_model": "lineitem",
     "dimensions": [
      "part.part_name",
      "part.manufacturer",
      "partsupp.supply_cost"
     ],
     "measures": [
      "total_quantity"
     ],
     "filters": [
      "ship_date in '1997'"
     ]
    },
    {
     "source_model": {
      "source_name": "offer_lines",
      "joins": [
       {
        "target_model": "min_cost",
        "join_pairs": [
         [
          "part__part_name",
          "part__part_name"
         ],
         [
          "part__manufacturer",
          "part__manufacturer"
         ]
        ],
        "cardinality": "many_to_one"
       }
      ]
     },
     "dimensions": [
      "part__manufacturer"
     ],
     "measures": [
      {
       "formula": "sum(iif(partsupp__supply_cost == min_cost.min_supply_cost, total_quantity, 0)) / sum(total_quantity)",
       "name": "cheapest_source_qty_share"
      }
     ]
    }
   ],
   "columns": {
    "manufacturer": "offer_lines.part__manufacturer",
    "cheapest_source_qty_share": "offer_lines.cheapest_source_qty_share"
   },
   "notes": "The model declares no part key, so a part is identified by part_name + manufacturer (unique over all 200,000 parts). min_cost takes the minimum over every supplier offer of the part.\n",
   "domain": "operations",
   "difficulty": "hard",
   "result": "answered"
  },
