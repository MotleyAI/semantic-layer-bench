  {
   "id": "B14",
   "status": "attempted",
   "interface": "query",
   "query": {
    "source_model": "lineitem",
    "dimensions": [
     "supplier.supplier_name"
    ],
    "measures": [
     {
      "formula": "sum(iif(ship_date in '1995' and receipt_date > commit_date, 1.0, 0.0)) / sum(iif(ship_date in '1995', 1.0, 0.0))",
      "name": "late_share_1995"
     },
     {
      "formula": "sum(iif(ship_date in '1996' and receipt_date > commit_date, 1.0, 0.0)) / sum(iif(ship_date in '1996', 1.0, 0.0))",
      "name": "late_share_1996"
     },
     {
      "formula": "sum(iif(ship_date in '1996' and receipt_date > commit_date, 1.0, 0.0)) / sum(iif(ship_date in '1996', 1.0, 0.0)) - sum(iif(ship_date in '1995' and receipt_date > commit_date, 1.0, 0.0)) / sum(iif(ship_date in '1995', 1.0, 0.0))",
      "name": "late_share_change"
     }
    ],
    "filters": [
     "ship_date >= '1995'",
     "ship_date <= '1996'",
     "sum(iif(ship_date in '1995', 1, 0)) >= 50",
     "sum(iif(ship_date in '1996', 1, 0)) >= 50"
    ],
    "order": [
     {
      "column": "late_share_change",
      "direction": "desc"
     },
     {
      "column": "supplier.supplier_name",
      "direction": "asc"
     }
    ],
    "limit": 10
   },
   "columns": {
    "supplier_name": "lineitem.supplier.supplier_name",
    "late_share_1995": "lineitem.late_share_1995",
    "late_share_1996": "lineitem.late_share_1996",
    "late_share_change": "lineitem.late_share_change"
   },
   "domain": "operations",
   "difficulty": "hard",
   "result": "answered"
  },
